MONGO_DB=your_mongodb_connection_string
# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_KEY=your_jwt_secret_key

# Optional
PORT=3000
# Comma-separated list of browser origins allowed to call the API
FRONTEND_URL=http://localhost:4200
# Token lifetime (jsonwebtoken format, e.g. 1h, 1d)
JWT_EXPIRES_IN=1d
# Number of reverse proxies in front of the API, e.g. 1 behind a host's load
# balancer (see "Deploy on Render" in the README). Leave unset locally.
# TRUST_PROXY=1
